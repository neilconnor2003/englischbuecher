<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#7c3aed</item>
        <item name="colorPrimaryDark">#5e42d6</item>
        <item name="colorAccent">#c4b5fd</item>
        <item name="android:statusBarColor">#7c3aed</item>
        <item name="android:navigationBarColor">#7c3aed</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">#7c3aed</item>
        <item name="android:navigationBarColor">#7c3aed</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:statusBarColor">#f6f3ff</item>
    </style>
</resources>